{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffscape",
  "version": "0.1.0",
  "identifier": "dev.diffscape",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diffscape",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 14 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Read-only Git worktree explorer"
  }
}
